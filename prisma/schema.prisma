generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  ACTIVE
  INACTIVE
}

enum GameStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum AnswerResult {
  CORRECT
  INCORRECT
  TIMEOUT
}

enum BadgeType {
  FIRST_GAME
  QUESTIONS_50
  QUESTIONS_100
  STREAK_7
  STREAK_14
  STREAK_30
  STREAK_60
  STREAK_90
  TOP_10
  PERFECT_ROUND
  CORRECT_500
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
}

enum AdminStatus {
  ACTIVE
  BLOCKED
}

enum NotificationType {
  NEW_USER
  LEADERBOARD_TOPPED
  LEADERBOARD_MOVEMENT
  QUESTION_IMPORT
  USER_SUSPENDED
  SYSTEM
}

enum ChallengeStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum ChallengeParticipationStatus {
  JOINED
  COMPLETED
  ABANDONED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum WinnerSelectionType {
  LEADERBOARD
  RAFFLE
}

enum OtpPurpose {
  REGISTRATION
  LOGIN
}

// ─────────────────────────────────────────────
// USERS
// ─────────────────────────────────────────────

model User {
  id                String     @id @default(uuid())
  username          String     @unique
  phone             String     @unique
  status            UserStatus @default(ACTIVE)

  totalPoints       Int        @default(0)
  totalPointsReachedAt DateTime   @default(now())
  gamesPlayed       Int        @default(0)
  questionsAnswered Int        @default(0)
  correctAnswers    Int        @default(0)

  currentStreak     Int        @default(0)
  longestStreak     Int        @default(0)

  lastPlayedDate    DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  games                     GameSession[]
  answers                   GameAnswer[]
  streakRecords             StreakRecord[]
  badges                    UserBadge[]
  otpCodes                  OtpCode[]
  sessions                  UserSession[]
  notifications             AdminNotification[] @relation("UserNotification")
  challengeParticipations  ChallengeParticipation[]
  raffleEntries             RaffleEntry[]
  winnerSelections          WinnerSelection[]

  @@index([status])
  @@index([totalPoints])
  @@index([currentStreak])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// QUESTIONS
// ─────────────────────────────────────────────

model Question {
  id            String             @id @default(uuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctOption String
  category      TriviaCategory
  difficulty    QuestionDifficulty @default(MEDIUM)
  status        QuestionStatus     @default(ACTIVE)

  // MVP remains 1 point per correct answer.
  // Kept configurable at question level for future expansion.
  points        Int                @default(1)

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  gameQuestions GameQuestion[]

  @@index([category])
  @@index([difficulty])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// GAME SESSIONS
// ─────────────────────────────────────────────

model GameSession {
  id                  String     @id @default(uuid())
  userId              String

  status              GameStatus @default(IN_PROGRESS)

  totalQuestions      Int        @default(10)
  totalTimeSeconds    Int
  questionTimeSeconds Int

  score               Int        @default(0)
  correctAnswers      Int        @default(0)
  incorrectAnswers    Int        @default(0)
  questionsAnswered   Int        @default(0)

  startedAt           DateTime   @default(now())
  completedAt         DateTime?
  durationSeconds     Int?

  // Used for leaderboard tie-breaking.
  scoreReachedAt      DateTime?

  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  questions           GameQuestion[]

  @@index([userId])
  @@index([status])
  @@index([completedAt])
  @@index([scoreReachedAt])
}

// ─────────────────────────────────────────────
// QUESTIONS USED IN A GAME
// Snapshotting protects historical games when
// an admin later edits a question.
// ─────────────────────────────────────────────

model GameQuestion {
  id              String       @id @default(uuid())
  gameSessionId   String
  questionId      String

  questionNumber  Int

  questionText    String
  optionA         String
  optionB         String
  optionC         String
  optionD         String
  correctOption   String

  pointsAvailable Int          @default(1)

  answered        Boolean      @default(false)
  answeredAt      DateTime?
  startedAt       DateTime?

  gameSession     GameSession  @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)
  question        Question     @relation(fields: [questionId], references: [id], onDelete: Restrict)
  answer          GameAnswer?

  @@unique([gameSessionId, questionNumber])
  @@index([gameSessionId])
  @@index([questionId])
}

// ─────────────────────────────────────────────
// PLAYER ANSWERS
// ─────────────────────────────────────────────

model GameAnswer {
  id              String       @id @default(uuid())

  userId          String
  gameQuestionId  String

  selectedOption  String?
  result          AnswerResult
  pointsEarned    Int          @default(0)

  responseTimeMs  Int?
  answeredAt      DateTime     @default(now())

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameQuestion    GameQuestion @relation(fields: [gameQuestionId], references: [id], onDelete: Cascade)

  @@unique([gameQuestionId])
  @@index([userId])
  @@index([result])
  @@index([answeredAt])
}

// ─────────────────────────────────────────────
// DAILY STREAK HISTORY
// ─────────────────────────────────────────────

model StreakRecord {
  id            String   @id @default(uuid())
  userId        String

  streakDate    DateTime
  streakValue   Int

  completedGame Boolean  @default(false)

  createdAt     DateTime @default(now())

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, streakDate])
  @@index([userId])
  @@index([streakDate])
}

// ─────────────────────────────────────────────
// BADGES
// ─────────────────────────────────────────────

model Badge {
  id          String     @id @default(uuid())
  type        BadgeType  @unique
  name        String
  description String

  createdAt   DateTime   @default(now())

  users       UserBadge[]
}

model UserBadge {
  id        String   @id @default(uuid())
  userId    String
  badgeId   String

  earnedAt  DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// OTP AUTHENTICATION
// ─────────────────────────────────────────────

model OtpCode {
  id              String     @id @default(uuid())
  userId          String?
  phone           String

  // Temporary username stored while registration
  // is waiting for successful OTP verification.
  pendingUsername String?

  codeHash        String
  purpose         OtpPurpose

  expiresAt       DateTime
  verifiedAt      DateTime?
  attempts        Int        @default(0)

  createdAt       DateTime   @default(now())

  user            User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// USER SESSIONS
// ─────────────────────────────────────────────

model UserSession {
  id          String   @id @default(uuid())
  userId      String

  tokenHash   String   @unique
  expiresAt   DateTime
  lastUsedAt  DateTime   @default(now())

  createdAt   DateTime   @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// ADMIN USERS
// ─────────────────────────────────────────────

model AdminUser {
  id                String      @id @default(uuid())
  name              String
  email             String      @unique

  passwordHash      String

  role              AdminRole   @default(ADMIN)
  status            AdminStatus @default(ACTIVE)

  twoFactorEnabled  Boolean     @default(false)

  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastLoginAt       DateTime?

  sessions          AdminSession[]
  notifications     AdminNotification[] @relation("AdminNotification")
  auditLogs         AdminAuditLog[]

  @@index([status])
  @@index([role])
}

// ─────────────────────────────────────────────
// ADMIN SESSIONS
// ─────────────────────────────────────────────

model AdminSession {
  id          String     @id @default(uuid())
  adminId     String

  tokenHash   String     @unique
  expiresAt   DateTime
  lastUsedAt  DateTime   @default(now())

  createdAt   DateTime   @default(now())

  admin       AdminUser  @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────
// ADMIN NOTIFICATIONS
// ─────────────────────────────────────────────

model AdminNotification {
  id          String             @id @default(uuid())

  type        NotificationType
  title       String
  message     String

  isRead      Boolean            @default(false)

  userId      String?
  adminId     String?

  createdAt   DateTime           @default(now())
  readAt      DateTime?

  user        User?              @relation("UserNotification", fields: [userId], references: [id], onDelete: SetNull)
  admin       AdminUser?         @relation("AdminNotification", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// ADMIN AUDIT LOG
// ─────────────────────────────────────────────

model AdminAuditLog {
  id          String    @id @default(uuid())
  adminId     String?

  action      String
  entity      String
  entityId    String?
  details     Json?

  createdAt   DateTime  @default(now())

  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
}

// ─────────────────────────────────────────────
// COMMUNITY CHALLENGES
// ─────────────────────────────────────────────

model CommunityChallenge {
  id          String          @id @default(uuid())

  title       String
  description String

  bonusPoints Int             @default(5)

  startsAt    DateTime
  endsAt      DateTime

  status      ChallengeStatus @default(DRAFT)

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  participants ChallengeParticipation[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model ChallengeParticipation {
  id          String                       @id @default(uuid())

  challengeId String
  userId      String

  status      ChallengeParticipationStatus @default(JOINED)

  joinedAt    DateTime                     @default(now())
  completedAt DateTime?

  challenge   CommunityChallenge           @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user        User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([challengeId])
  @@index([userId])
}

// ─────────────────────────────────────────────
// FUTURE CAMPAIGNS / WINNER SYSTEM
// ─────────────────────────────────────────────

model Campaign {
  id               String         @id @default(uuid())

  name             String
  description      String?

  status           CampaignStatus @default(DRAFT)

  startsAt         DateTime
  endsAt           DateTime

  leaderboardSlots Int            @default(30)
  raffleSlots      Int            @default(10)
  requiredStreak   Int            @default(30)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  winners          WinnerSelection[]
  raffleEntries    RaffleEntry[]

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
}

model RaffleEntry {
  id             String    @id @default(uuid())

  campaignId     String
  userId         String

  eligible       Boolean   @default(false)
  eligibleStreak Int?

  createdAt      DateTime  @default(now())

  campaign       Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([userId])
  @@index([eligible])
}

model WinnerSelection {
  id            String             @id @default(uuid())

  campaignId    String
  userId        String

  selectionType WinnerSelectionType
  rankPosition  Int?

  selectedAt    DateTime           @default(now())

  campaign      Campaign           @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId])
  @@index([selectionType])
}

// ─────────────────────────────────────────────
// FIXED TINKHUB CATEGORIES
// ─────────────────────────────────────────────

enum TriviaCategory {
  GENERAL_KNOWLEDGE
  SCIENCE
  HISTORY
  SPORTS
  GEOGRAPHY
  ENTERTAINMENT
  TECHNOLOGY
  BUSINESS
  CURRENT_AFFAIRS
}

// ─────────────────────────────────────────────
// GAME SETTINGS
// ─────────────────────────────────────────────

model GameSettings {
  id                    String   @id @default(uuid())

  questionsPerSession   Int      @default(10)

  // TOTAL session time.
  // The game engine divides this equally across
  // the questions in the session.
  totalTimeSeconds      Int      @default(600)

  pointsPerCorrectAnswer Int      @default(1)

  randomizeQuestions    Boolean  @default(true)

  streakTimezone        String   @default("Africa/Lagos")

  updatedAt             DateTime @updatedAt
}